{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "上班鼓励器",
  "version": "../package.json",
  "identifier": "dev.toys.work-cheer",
  "build": {
    "beforeDevCommand": "pnpm run dev:web",
    "beforeBuildCommand": "pnpm run build:web",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "上班鼓励器",
        "width": 440,
        "height": 660,
        "minWidth": 345,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://127.0.0.1:1421; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.ico"
    ]
  }
}
